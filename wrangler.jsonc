{
  "name": "isaiah-boyd",
  "compatibility_date": "2026-11-01",
  "main": "worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "VISITORS", "class_name": "VisitorCounter" },
      { "name": "BENCHMARKS", "class_name": "Benchmarks" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["VisitorCounter"] },
    { "tag": "v2", "new_sqlite_classes": ["Benchmarks"] }
  ]
}
